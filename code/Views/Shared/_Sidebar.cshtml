<div class="d-flex flex-column flex-shrink-0 bg-dark position-fixed top-0 start-0"
     style="width: 4rem; height: 100vh;">
    <ul class="nav nav-pills nav-flush flex-column text-center flex-grow-1 justify-content-center">
        <li>
            <a href="#home" class="nav-link py-3 rounded-0 text-light" title="Home" data-color="#000">
                <span>@Html.Raw(userIcon)</span>
            </a>
        </li>
        <li>
            <a href="#skills" class="nav-link py-3 rounded-0 text-light" title="Skills" data-color="#0d6efd">
                <span>@Html.Raw(skillIcon)</span>
            </a>
        </li>
        <li>
            <a href="#experience" class="nav-link py-3 rounded-0 text-light" title="Experience" data-color="#ffc107">
                <span>@Html.Raw(briefcaseIcon)</span>
            </a>
        </li>
        <li>
            <a href="#projects" class="nav-link py-3 rounded-0 text-light" title="Projects" data-color="#198754">
                <span>@Html.Raw(cubeIcon)</span>
            </a>
        </li>
    </ul>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");

        const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    navLinks.forEach(link => link.classList.remove("active"));

                    const activeLink = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
                    if (activeLink) {
                        const color = activeLink.getAttribute("data-color");
                        activeLink.style.setProperty("--active-color", color);
                        activeLink.classList.add("active");
                    }
                }
            });
        }, { threshold: 0.6 });

        sections.forEach(section => observer.observe(section));
    });
</script>
